#. +> trunk6 stable6 stable5
#: kcm/ui/main.qml:40
#, kde-format
msgid "Update software:"
msgstr "อัปเดตซอฟต์แวร์:"

#. +> trunk6 stable6 stable5
#: kcm/ui/main.qml:41
#, kde-format
msgid "Manually"
msgstr "ด้วยมือ"

#. +> trunk6 stable6 stable5
#: kcm/ui/main.qml:51
#, kde-format
msgid "Automatically"
msgstr "โดยอัตโนมัติ"

#. +> trunk6 stable6 stable5
#: kcm/ui/main.qml:58
#, kde-kuit-format
msgctxt "@info"
msgid "Software updates will be downloaded automatically when they become available. Updates for applications will be installed immediately, while system updates will be installed the next time the computer is restarted."
msgstr "การอัปเดตซอฟต์แวร์จะถูกดาวน์โหลดอัตโนมัติเมื่อมีมาใหม่ อัปเดตสำหรับแอปจะถูกติดตั้งทันที ในขณะที่อัปเดตสำหรับระบบจะถูกติดตั้งในครั้งถัดไปที่เครื่องรีสตาร์ท"

#. +> trunk6 stable6 stable5
#: kcm/ui/main.qml:69
#, kde-format
msgctxt "@title:group"
msgid "Update frequency:"
msgstr "ความถี่ในการอัปเดต:"

#. +> trunk6 stable6 stable5
#: kcm/ui/main.qml:69
#, kde-format
msgctxt "@title:group"
msgid "Notification frequency:"
msgstr "ความถี่ในการแจ้งเตือน:"

#. +> trunk6 stable6 stable5
#: kcm/ui/main.qml:72
#, kde-format
msgctxt "@item:inlistbox"
msgid "Daily"
msgstr "ทุกวัน"

#. +> trunk6 stable6 stable5
#: kcm/ui/main.qml:73
#, kde-format
msgctxt "@item:inlistbox"
msgid "Weekly"
msgstr "ทุกสัปดาห์"

#. +> trunk6 stable6 stable5
#: kcm/ui/main.qml:74
#, kde-format
msgctxt "@item:inlistbox"
msgid "Monthly"
msgstr "ทุกเดือน"

#. +> trunk6 stable6 stable5
#: kcm/ui/main.qml:75
#, kde-format
msgctxt "@item:inlistbox"
msgid "Never"
msgstr "ไม่ทำ"

#. +> stable5
#: kcm/package/contents/ui/main.qml:111
#, kde-format
msgid "Use offline updates:"
msgstr "ใช้อัพเดตออฟไลน์"

#. +> trunk6 stable6
#: kcm/ui/main.qml:119
#, kde-format
msgid "Apply system updates:"
msgstr "ดำเนินการอัปเดตระบบ:"

#. +> stable5
#: kcm/package/contents/ui/main.qml:124
#, kde-format
msgid "Offline updates maximize system stability by applying changes while restarting the system. Using this update mode is strongly recommended."
msgstr "การอัพเดตแบบออฟไลน์ช่วยเพิ่มเสถียรภาพให้ระบบ โดยอัพเดตในขณะที่ระบบกำลังรีสตาร์ท แนะนำอย่างยิ่งให้ใช้โหมดการอัพเดตนี้"

#. +> trunk6 stable6
#: kcm/ui/main.qml:126
#, kde-format
msgctxt "@option:radio part of the logical sentence 'Apply system updates after rebooting'"
msgid "After rebooting"
msgstr "หลังรีสตารท์"

#. +> trunk6 stable6
#: kcm/ui/main.qml:133
#, kde-format
msgctxt "@label The thing being recommended is to use the 'apply updates when rebooting' setting"
msgid "Recommended to maximize system stability"
msgstr "แนะนำเพื่อความเสียรของระบบสูงสุด"

#. +> trunk6 stable6
#: kcm/ui/main.qml:139
#, kde-format
msgctxt "@option:radio part of the logical sentence 'Apply system updates immediately'"
msgid "Immediately"
msgstr "ทันที"

#. +> stable5
#: kcm/updates.cpp:31
#, kde-format
msgid "Software Update"
msgstr "อัพเดตซอฟต์แวร์"

#. +> stable5
#: kcm/updates.cpp:33
#, kde-format
msgid "Configure software update settings"
msgstr "ตั้งค่าการอัพเดตซอฟต์แวร์"
